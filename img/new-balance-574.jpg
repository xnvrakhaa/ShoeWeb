    <script data-skip-moving="true">
		(function() {
			var langCookieName = 'site_lang';
			var cookieMaxAgeDays = 365;

			function getCookie(name) {
				var cookies = document.cookie ? document.cookie.split('; ') : [];

				for (var i = 0; i < cookies.length; i++) {
					if (cookies[i].indexOf(name + '=') === 0) {
						return decodeURIComponent(cookies[i].split('=')[1]);
					}
				}

				return '';
			}
		
			function setCookie(name, value, days) {
				var expires = "";
				if (days) {
					var date = new Date();
					date.setTime(date.getTime() + (days*24*60*60*1000));
					expires = "; expires=" + date.toUTCString();
				}
				document.cookie = name + "=" + encodeURIComponent(value) + expires + "; path=/";
			}

			function isSystemPath(path) {
				return path.indexOf('/bitrix/') === 0 || path.indexOf('/api/') === 0;
			}

			function hasKzPrefix(path) {
				return path === '/kz' || path.indexOf('/kz/') === 0;
			}

			function getPathByLang(lang, path) {
				if (lang === 'ru' && hasKzPrefix(path)) {
					return path.replace(/^\/kz(?=\/|$)/, '') || '/';
				}

				if (lang === 'kz' && !hasKzPrefix(path)) {
					return '/kz' + path;
				}

				return path;
			}

			function getLangLink(target) {
				while (target && target !== document) {
					if (target.getAttribute && target.getAttribute('data-lang-code')) {
						return target;
					}

					target = target.parentNode;
				}

				return null;
			}

			document.addEventListener('click', function(event) {
				var langLink = getLangLink(event.target);

				if (!langLink) {
					return;
				}

				var lang = langLink.getAttribute('data-lang-code');

				if (lang === 'ru' || lang === 'kz') {
					setCookie(langCookieName, lang, cookieMaxAgeDays);
				}
			});

            var savedLang = getCookie(langCookieName);

            if (savedLang !== 'ru' && savedLang !== 'kz') {
                return;
                // savedLang = 'ru';
                // setCookie(langCookieName, savedLang, cookieMaxAgeDays);
            }

			var path = window.location.pathname;

			if (!isSystemPath(path)) {
				var newPath = getPathByLang(savedLang, path);

				if (newPath !== path) {
					window.location.replace(newPath + (window.location.search || '') + (window.location.hash || ''));
				}
			}
		})();
	</script>

